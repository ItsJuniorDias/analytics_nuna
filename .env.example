# Copie para .env (que o git ignora) e preencha.

# Chaves aceitas no cabeçalho X-Nuna-Key, separadas por vírgula (rotação).
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
NUNA_APP_KEYS=VfbqsuCuIj22Qg2yoWPHqYBxUdGmstaD

# Token das rotas /v1/stats e do painel /dashboard (mínimo 16 caracteres).
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NUNA_ADMIN_TOKEN=nqBS5GBno1KWEHC9VfX4RzsLlW8mVHavDK-VuCWVOmI

# Arquivo SQLite. No Docker/Render: /data/analytics.db
NUNA_DB_PATH=./data/analytics.db

# Dias até apagar eventos individuais (fica só o total diário por evento).
NUNA_RETENTION_DAYS=180

# Máximo de eventos por requisição e tamanho máximo do corpo em bytes.
NUNA_MAX_BATCH=100
NUNA_MAX_BODY_BYTES=262144

# Janela aceita para o timestamp do cliente.
NUNA_MAX_EVENT_AGE_DAYS=30
NUNA_MAX_CLOCK_SKEW_HOURS=24

# Limpeza automática dentro do serviço (0 desliga; aí rode python -m app.purge).
NUNA_PURGE_INTERVAL_HOURS=24

# Origens com CORS liberado (vazio = nenhuma; o app iOS não precisa).
NUNA_CORS_ORIGINS=

# /docs e /openapi.json (desligado em produção).
NUNA_ENABLE_DOCS=false
